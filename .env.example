# --- Gemini ---
GEMINI_API_KEY=your_gemini_key        # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash         # change if you want another model
SYSTEM_PROMPT=You are a friendly assistant. Reply in the user's language (Khmer or English). Keep answers short.

# --- Bot (BotFather) ---
BOT_TOKEN=123456:ABC...
ADMIN_IDS=123456789                   # comma separated

# --- Userbot (my.telegram.org -> API development tools) ---
TG_API_ID=1234567
TG_API_HASH=your_api_hash
IGNORE_CHATS=                         # comma separated chat IDs to never reply in

DATA_DIR=./data

# --- Webhook mode (bot only; leave WEBHOOK_URL empty = polling) ---
WEBHOOK_URL=                          # https://bot.yourdomain.com
WEBHOOK_SECRET=change_me_random_string
WEBHOOK_PORT=8443
DOMAIN=bot.yourdomain.com             # used by Caddy for automatic HTTPS
